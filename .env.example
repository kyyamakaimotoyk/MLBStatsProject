AWS_REGION=us-east-1

# RDS Postgres — values come from `terraform output` in infra/
MLB_DB_HOST=
MLB_DB_PORT=5432
MLB_DB_NAME=mlb_data
MLB_DB_USER=mlbadmin

# Leave MLB_DB_PASSWORD empty to fetch the current password from Secrets
# Manager via MLB_DB_SECRET_ARN (survives RDS-managed rotation; requires AWS
# credentials in the environment). Setting MLB_DB_PASSWORD overrides.
MLB_DB_PASSWORD=
MLB_DB_SECRET_ARN=

# Timeout guardrails. connect_timeout is always applied (default 10s).
# MLB_DB_STATEMENT_TIMEOUT is a server-side ceiling per statement, passed to
# Postgres verbatim — a bare number is milliseconds, or give a unit ("15s").
# Leave it EMPTY locally and for the pipeline: feature builds and walk-forward
# pulls legitimately run for minutes and a ceiling would kill them mid-run.
# The API sets it to 15s in its ECS task definition (infra/api_service.tf).
MLB_DB_CONNECT_TIMEOUT=10
MLB_DB_STATEMENT_TIMEOUT=

# S3 — one bucket, three prefixes (raw/, models/, exports/)
MLB_DATA_BUCKET=
MLB_RAW_PREFIX=raw/
MLB_MODELS_PREFIX=models/
