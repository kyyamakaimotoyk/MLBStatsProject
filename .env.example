AWS_REGION=us-east-1

# RDS Postgres — values come from `terraform output` in infra/
MLB_DB_HOST=
MLB_DB_PORT=5432
MLB_DB_NAME=mlb_data
MLB_DB_USER=mlbadmin

# Leave MLB_DB_PASSWORD empty to fetch the current password from Secrets
# Manager via MLB_DB_SECRET_ARN (survives RDS-managed rotation; requires AWS
# credentials in the environment). Setting MLB_DB_PASSWORD overrides.
MLB_DB_PASSWORD=
MLB_DB_SECRET_ARN=

# S3 — one bucket, three prefixes (raw/, models/, exports/)
MLB_DATA_BUCKET=
MLB_RAW_PREFIX=raw/
MLB_MODELS_PREFIX=models/
